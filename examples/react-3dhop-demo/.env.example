# Copy to .env (gitignored) to override the Vite dev server for a native `npm run dev`.
#
# Not needed for `docker compose up dev` — that gets its values from the repository root's
# .env instead (see ../../.env.example), which compose.yaml forwards into the container's
# environment. This file is for reproducing the same override when running outside Docker.

# Interface the dev server binds to. Leave unset for Vite's default (localhost only).
VITE_DEV_HOST=

# Port the dev server listens on. Leave unset for Vite's default (5173, or the next free port).
VITE_DEV_PORT=

# Comma-separated hostnames to accept requests for, beyond localhost — e.g. a reverse-proxied
# hostname. Vite otherwise rejects any Host header it doesn't recognise.
VITE_ALLOWED_HOSTS=
