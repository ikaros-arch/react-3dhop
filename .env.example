# Copy to .env (gitignored) to configure the Docker dev server; see docs/docker.md.
#
# compose.yaml substitutes these into the `dev` service's port mapping and forwards them into the
# container as real environment variables, which examples/react-3dhop-demo/vite.config.ts reads.
# Defaults match compose.yaml's own fallbacks, so this file is only needed to change them.

# Host the dev server binds to inside the container. Must stay 0.0.0.0 for the published port to
# reach it from the host machine.
VITE_DEV_HOST=0.0.0.0

# Port the dev server listens on, and the host port it is published as (both sides of the mapping
# use this value).
VITE_DEV_PORT=8085

# Comma-separated hostnames to accept requests for, beyond localhost — e.g. the hostname a reverse
# proxy fronts the container with. Vite otherwise rejects any Host header it doesn't recognise.
VITE_ALLOWED_HOSTS=
