{
  "name": "react-3dhop-workspace",
  "private": true,
  "description": "Workspace root for the react-3dhop packages",
  "license": "GPL-3.0-or-later",
  "author": "Hallvard R. Indgjerd",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@ikaros-arch/react-3dhop --workspace=@ikaros-arch/react-3dhop-iiif",
    "dev": "npm run dev --workspace=react-3dhop-demo",
    "lint": "npm run lint --workspace=@ikaros-arch/3dhop --workspace=@ikaros-arch/react-3dhop --workspace=@ikaros-arch/react-3dhop-iiif",
    "pack:dry": "npm pack --dry-run --workspace=@ikaros-arch/3dhop --workspace=@ikaros-arch/react-3dhop --workspace=@ikaros-arch/react-3dhop-iiif",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "typescript": "^5.3.3",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^4.1.11"
  }
}
